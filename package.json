{
	"name": "dumbscope",
	"version": "0.2.3",
	"private": true,
	"description": "Observability control center for the DUMB media stack",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"mock:dumb": "node tests/mock-dumb/server.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.0",
		"@lucide/svelte": "^0.525.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/vite": "^4.1.0",
		"@testing-library/svelte": "^5.2.0",
		"@types/node": "^22.15.0",
		"eslint": "^9.30.0",
		"eslint-config-prettier": "^10.1.0",
		"eslint-plugin-svelte": "^3.10.0",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"svelte": "^5.35.0",
		"svelte-check": "^4.2.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.35.0",
		"vite": "^6.3.0",
		"vitest": "^3.2.0",
		"zod": "^4.0.0"
	},
	"dependencies": {},
	"pnpm": {
		"overrides": {
			"cookie": "0.7.2"
		}
